{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "wanlly",
	"main": "workers/site/entry.js",
	"compatibility_date": "2026-06-01",
	"compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
	"assets": {
		"directory": ".open-next/assets",
		"binding": "ASSETS"
	},
	"observability": { "enabled": true },
	// Daily at 07:15 UTC (10:15 in Nairobi): come-back emails (workers/site/entry.js → /api/cron/nudges).
	"triggers": { "crons": ["15 7 * * *"] },
	// Keep the variables set in the Cloudflare dashboard on every deploy; without this, each deploy
	// deletes the plain-text ones (secrets are always kept).
	"keep_vars": true
	// No R2 cache yet: R2 needs a card on file. Add it with the incremental cache when that's set up.
}
