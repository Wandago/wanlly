# Copy to .env.local for local work. In production these live in Cloudflare (Workers > Settings > Variables and secrets).
# Never commit real values. In Cloudflare, NEXT_PUBLIC_ values are build variables; the rest are runtime secrets.

# Clerk (dashboard.clerk.com > API keys)
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_your_key_here
CLERK_SECRET_KEY=
# Clerk > Webhooks > your endpoint > Signing secret
CLERK_WEBHOOK_SIGNING_SECRET=
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up

# Neon (console.neon.tech > project wanlly > Connect > pooled connection string)
DATABASE_URL=

# AI models: each one switches on its models when set. Optional; Admin > AI check tests them.
# Google AI Studio (Gemini Flash, Gemini Image)
GEMINI_API_KEY=
# console.anthropic.com (Claude)
ANTHROPIC_API_KEY=
# platform.deepseek.com (DeepSeek V4 Flash and Pro)
DEEPSEEK_API_KEY=
# console.x.ai (Grok)
XAI_API_KEY=
# Free tiers used by Auto (free): build.nvidia.com, cloud.cerebras.ai, console.groq.com, console.mistral.ai, openrouter.ai
NVIDIA_API_KEY=
CEREBRAS_API_KEY=
GROQ_API_KEY=
MISTRAL_API_KEY=
OPENROUTER_API_KEY=
