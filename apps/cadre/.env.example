# Clerk (free plan). Dashboard > API keys. Turn on Organizations.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up

# Neon (free plan). The app connects as a login role that is a member of cadre_app,
# never as the owner, so row-level security applies to every query.
DATABASE_URL=postgres://cadre_app_login:PASSWORD@HOST/neondb?sslmode=require

# Only for running migrations (pnpm db:migrate): the database owner.
DATABASE_MIGRATION_URL=postgres://neondb_owner:PASSWORD@HOST/neondb?sslmode=require
